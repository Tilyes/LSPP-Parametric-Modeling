$# LS-PrePost command file (PC column impact model)
/*  PC 柱水平冲击模型 —— LS-PrePost 命令行脚本（cfile）                        */
/*  运行方式：LS-PrePost -> File -> Open -> Command File -> 选择本文件 -> Start */
/*  内容：材料(MAT_*) / 沙漏(HOURGLASS) / 截面(SECTION_*) / Part-Section-MAT 关联 /
/*        轴压荷载 / 接触 / 约束 / 初速度 / 系统控制 / 输出设置                  */
/*  注意：边界条件(BOUNDARY)在 LSPP 中运行会卡死，已注释，需在界面里手动添加    */
$#
partdata rename 6 "D_column_lr"
partdata rename 7 "Sleeve"
partdata rename 8 "U_column_lr"
partdata rename 9 "Stirrups"
partdata rename 10 "Foundation_hoop"
partdata rename 12 "Foot_lr"

$# ########################## Material input ###########################
KEYWORD INPUT 1
*MAT_CSCM_CONCRETE_TITLE
Mat_for_first_concrete
$#     mid        ro     nplot     incre     irate     erode     recov   itretrc
         1    2.4e-9         1       0.0         1      1.10       0.5         0
$#    pred
       0.0
$#     fpc      dagg     units
      35.4      10.0         2
*END
keyword updatekind
MAT_CSCM_CONCRETE

KEYWORD INPUT 2
*MAT_CSCM_CONCRETE_TITLE
Mat_for_second_concrete
$#     mid        ro     nplot     incre     irate     erode     recov   itretrc
         2    2.4e-9         1       0.0         1      1.10       0.5         0
$#    pred
       0.0
$#     fpc      dagg     units
      47.4      10.0         2
*END
keyword updatekind
MAT_CSCM_CONCRETE

KEYWORD INPUT 3
*MAT_ELASTIC_TITLE
Mat_for_truck
$#     mid        ro         e        pr        da        db  not used
         38.00000E-9  200000.0       0.3       0.0       0.0       0.0
*END
keyword updatekind
MAT_RIGID

KEYWORD INPUT 4
*MAT_PLASTIC_KINEMATIC_TITLE
Mat_for_col_lr
$#     mid        ro         e        pr      sigy      etan      beta
         4    7.8e-9  200000.0       0.3     400.0    1500.0       1.0
$#     src       srp        fs        vp
   7.274e7      11.2      0.20       0.0
*END
keyword updatekind
MAT_PLASTIC_KINEMATIC

KEYWORD INPUT 5
*MAT_PLASTIC_KINEMATIC_TITLE
Mat_for_sleeve
$#     mid        ro         e        pr      sigy      etan      beta
         5    7.8e-9  200000.0       0.3     400.0    1500.0       1.0
$#     src       srp        fs        vp
   7.274e7      11.2      0.15       0.0
*END
keyword updatekind
MAT_PLASTIC_KINEMATIC
KEYWORD INPUT 6
*MAT_PLASTIC_KINEMATIC_TITLE
Mat_for_steelborad
$#     mid        ro         e        pr      sigy      etan      beta
         6    7.8e-9  210000.0       0.3     400.0    2100.0       1.0
$#     src       srp        fs        vp
      40.0       5.0      0.15       0.0
*END
keyword updatekind
MAT_PLASTIC_KINEMATIC



$# ############################### 沙漏材料系数 ####################################
KEYWORD INPUT 7
*HOURGLASS_TITLE
MAT1
$#    hgid       ihq        qm       ibq        q1        q2    qb/vdc        qw
         1         4      0.03         0       1.5      0.06       0.1       0.1
*END
keyword updatekind
HOURGLASS_HOURGLASS

KEYWORD INPUT 8
*HOURGLASS_TITLE
MAT2
$#    hgid       ihq        qm       ibq        q1        q2    qb/vdc        qw
         2         4      0.03         0       1.5      0.06       0.1       0.1
*END
keyword updatekind
HOURGLASS_HOURGLASS

$# 全局沙漏设置
KEYWORD INPUT 9
*CONTROL_HOURGLASS
$#     ihq        qh
         4      0.03
*END
keyword updatekind
CONTROL_HOURGLASS

$# ########################## Section defination ##########################

KEYWORD INPUT 10
*SECTION_SOLID_TITLE
Section_for_solid
$#   secid    elform       aet    unused    unused    unused    cohoff   gaskeit
         1         1         0                                     0.0       0.0
*END
keyword updatekind
SECTION_SOLID

KEYWORD INPUT 11
*SECTION_BEAM_TITLE
Section_for_10mm_rebar
$#   secid    elform      shrf   qr/irid       cst     scoor       nsm     naupd
         2         1       1.0         2         1       0.0       0.0         0
$#     ts1       ts2       tt1       tt2     nsloc     ntloc
      10.0      10.0       0.0       0.0       0.0       0.0
*END
keyword updatekind
SECTION_BEAM

KEYWORD INPUT 12
*SECTION_BEAM_TITLE
Section_for_16mm_rebar
$#   secid    elform      shrf   qr/irid       cst     scoor       nsm     naupd
         3         1       1.0         2         1       0.0       0.0         0
$#     ts1       ts2       tt1       tt2     nsloc     ntloc
      16.0      16.0       0.0       0.0       0.0       0.0
*END
keyword updatekind
SECTION_BEAM

SECTION_BEAM
KEYWORD INPUT 13
*SECTION_BEAM_TITLE
Setion_for_sleeve_32mm
$#   secid    elform      shrf   qr/irid       cst     scoor       nsm     naupd
         4         1       1.0         2         1       0.0       0.0         0
$#     ts1       ts2       tt1       tt2     nsloc     ntloc
      32.0      32.0       0.0       0.0       0.0       0.0
*END
keyword updatekind
SECTION_BEAM

$# ####################### link-section mat part ################################
$# partdata assignapply (*PART Parameter/*SECTION Formulation) SECID MID EOSID HGID TMID GRAV ADPOPT

partdata assignapply 0 1 1 0 1 -1 -1 0 1
partdata assignapply 0 1 2 0 2 -1 -1 0 2
partdata assignapply 0 1 1 0 1 -1 -1 0 3
partdata assignapply 0 1 3 0 1 -1 -1 0 4
partdata assignapply 0 1 6 0 0 -1 -1 0 5
partdata assignapply 0 3 4 0 0 -1 -1 0 6
partdata assignapply 0 6 5 0 0 -1 -1 0 7
partdata assignapply 0 3 4 0 0 -1 -1 0 8
partdata assignapply 0 2 4 0 0 -1 -1 0 9
partdata assignapply 0 3 4 0 0 -1 -1 0 10
partdata assignapply 0 3 4 0 0 -1 -1 0 12

$# ############################# LOAD ############################

$# 轴压加载

KEYWORD INPUT 16
*DEFINE_CURVE
$#    lcid      sidr       sfa       sfo      offa      offo    dattyp     lcint
         1         2       1.0       1.0       0.0       0.0         0         0
$#                a1                  o1
                 0.0                 1.0
              2e10.0                 1.0
*END
keyword updatekind
DEFINE_CURVE
KEYWORD INPUT 17
*LOAD_SEGMENT_SET_ID
$#      id                                                               heading
         1
$#    ssid      lcid        sf        at
         1         1      2.68       0.0
*END
keyword updatekind
LOAD_SEGMENT_SET


$# ############################# BOUNDARY ############################
$# spcdata create set 1 0 0 0 1 0 0 0 0
$# spcdata create set 2 0 1 0 0 0 0 0 0

